{
  "name": "quad-computing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0 -p 3000",
    "dev:webpack": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:migrations": "node scripts/check-migrations.mjs",
    "audit:guards": "node scripts/audit-guards.mjs",
    "verify:env": "node scripts/verify-env.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:migrations && npm run audit:guards",
    "build:release": "npm run verify:env && npm run test && next build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.19",
    "@sentry/nextjs": "^11.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.4.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.47.0",
    "next": "^15.5.27",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.19",
    "dotenv": "^18.0.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "uuid": "^14.0.2",
    "vitest": "^1.6.1",
    "ws": "^8.21.3"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
